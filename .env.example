# Copy to .env (never committed). The app boots with every line below left as it is: mock backend, no key, no network for the app.

# --- Which model answers: ONE switch. mock (default, offline) | meta | openai_compat
LLM_BACKEND=mock

# --- meta: the Meta Model API. Needed only with LLM_BACKEND=meta.
META_API_KEY=
# Optional. Default: muse-spark-1.3 (see app/llm/client.py).
# META_MODEL=muse-spark-1.3

# --- openai_compat: any OpenAI-compatible host (open weights). Needed only with LLM_BACKEND=openai_compat. Tested only against fakes.
# OPENAI_COMPAT_BASE_URL=
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=

# --- Model call tuning (optional)
# Reasoning effort: minimal, low, medium, high, xhigh, max. Default for meta: minimal.
# LLM_REASONING_EFFORT=minimal
# Seconds per model request (default 20).
# LLM_TIMEOUT_S=20

# --- App
# Fixed as-of date for the demo data (otherwise today's date is used).
LOREG_AS_OF=2026-10-26
# Demo mode: adds the "Use the demo stock list" button and labels the synthetic demo article. It signs nobody in. Never on a host others can reach.
# LOREG_DEMO=1
# The demo account made by scripts/reset_demo.py (default: the public demo credential in the README). Never a real account.
# LOREG_DEMO_EMAIL=
# LOREG_DEMO_PASSWORD=
# production: no demo account is made, the app refuses to start with LOREG_DEMO=1, the API docs (/docs, /openapi.json) are off,
# and the cookies are marked Secure (so it must be reached over https).
# LOREG_ENV=production
# Secure flag on the cookies: 1 always (behind a proxy that ends https), 0 never (a plain-http test). Unset: when the app sees https,
# and always under LOREG_ENV=production.
# LOREG_COOKIE_SECURE=
# Database file (default data/loreg.sqlite).
# LOREG_DB=data/loreg.sqlite
# Seconds a whole chat answer may take before every unfinished step uses the rules-based fallback (default 45).
# LOREG_REQUEST_TIMEOUT_S=45
# Log level for the JSON request and agent-call lines on stderr (default INFO; WARNING silences them).
# LOREG_LOG_LEVEL=INFO
